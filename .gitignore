# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (unanchored - catches a nested copy too, not just the root one)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# coverage output, if anything ever writes it (no test runner here by design)
coverage/

# next.js
.next/
out/

# production
build/

# build tool caches - all rebuildable, none of it belongs in a diff
.turbo/
.swc/
.eslintcache
*.cache

# prisma - the generated client is rebuilt by `prisma generate`, never committed
/prisma/generated/
**/generated/prisma/
.prisma/

# os junk
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# editor scratch files
*.swp
*.swo
*~

# keys and certs - nothing of this shape is ever meant to be committed
*.pem
*.key
*.crt
*.p12
*.pfx

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors (personal layout, not shared - but a team-wide vscode config can opt in)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# claude code (local machine settings, not shared)
# note: .claude/skills/ and .agents/skills/ ARE committed - skills-lock.json
# records their source + hash, but the files themselves travel with the repo
# so a fresh clone has identical agent guidance with no restore step.
.claude/*.local.json
.agents/*.local.json

# obsidian vault state (docs/) - workspace layout + installed plugin binaries
docs/.obsidian/

# claudian session transcripts (docs/) - personal, not for the repo
docs/.claudian/

# filled-in postman environment (holds a clerk secret key). the committed
# template is docs/llm-arena.postman_environment.template.json
docs/*.postman_environment.json
