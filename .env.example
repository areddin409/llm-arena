# Copy this file to .env.local and fill in the blanks. .env.local is gitignored;
# this file is committed and must never hold a real key.
#
# Everything under "Required to boot" is validated by env.ts at import time, so
# a missing or malformed value stops the process on startup with a message
# naming every problem at once. If the dev server refuses to start, read that
# message — it tells you exactly which variable and what shape it wants.


# --- Required to boot -------------------------------------------------------

# OpenRouter — the single upstream for every model in the arena.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Arcjet — rate limiting and bot detection on the route that spends real money
# upstream. Without it that endpoint would run wide open, so the app refuses to
# boot rather than start unprotected.
# Site key from https://app.arcjet.com — starts with ajkey_
ARCJET_KEY=

# Postgres, via Prisma. Connection string from https://console.prisma.io —
# the database's Connect dialog, not the URL in the browser's address bar.
# Must start with postgres:// or postgresql://
# The Prisma CLI reads this too, loaded from .env.local by prisma.config.ts.
DATABASE_URL=

# Clerk — auth. Both keys come from the same instance:
# https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostHog — product analytics.
# Project API key from Settings → Project. Starts with phc_.
# This is NOT a personal API key; those start with phx_ and belong below.
NEXT_PUBLIC_POSTHOG_KEY=
# The ingestion host, which is not the dashboard host. Pointing this at
# us.posthog.com drops every event silently, so env.ts rejects that on boot.
# Use https://us.i.posthog.com or https://eu.i.posthog.com — note the `.i.`
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# --- Read by Clerk itself, not by env.ts ------------------------------------
# Not secrets, and the values below are the ones this app actually uses. They
# only need changing if the sign-in or sign-up routes move.

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/


# --- Optional, local tooling only -------------------------------------------
# No application code reads these. Leave them blank and the app runs fine.

# Lets the PostHog MCP server query real analytics data instead of guessing.
# Personal API key from https://app.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=
